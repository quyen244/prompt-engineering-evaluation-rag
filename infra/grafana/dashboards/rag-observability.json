{
  "annotations": {"list": []},
  "editable": false,
  "schemaVersion": 39,
  "title": "RAG upload and query observability",
  "tags": ["rag", "telemetry-as-code"],
  "timezone": "utc",
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "p50 latency by stage", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "histogram_quantile(0.50, sum(rate(rag_query_duration_seconds_bucket[5m])) by (le, stage))", "legendFormat": "{{stage}}"}]},
    {"id": 2, "type": "timeseries", "title": "p95 latency by stage", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(rag_query_duration_seconds_bucket[5m])) by (le, stage))", "legendFormat": "{{stage}}"}]},
    {"id": 3, "type": "timeseries", "title": "Error rate", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}, "targets": [{"expr": "sum(rate(rag_errors_total[5m])) by (stage, error_type) or vector(0)", "legendFormat": "{{stage}} / {{error_type}}"}]},
    {"id": 4, "type": "timeseries", "title": "Tokens per minute", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}, "targets": [{"expr": "sum(rate(llm_tokens_total[15m])) by (token_type, model) * 60", "legendFormat": "{{token_type}} / {{model}}"}]},
    {"id": 5, "type": "timeseries", "title": "LLM spend per hour", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}, "targets": [{"expr": "sum(rate(llm_cost_usd_total[15m])) by (model, endpoint) * 3600", "legendFormat": "{{model}} / {{endpoint}} USD/hour"}]},
    {"id": 6, "type": "heatmap", "title": "Retrieval top-score distribution", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"expr": "sum(rate(rag_retrieval_top_score_bucket[10m])) by (le, retrieval_strategy)", "legendFormat": "{{retrieval_strategy}}"}]},
    {"id": 7, "type": "timeseries", "title": "No-answer rate (%)", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"expr": "100 * sum(increase(rag_no_answer_total[10m])) / clamp_min(sum(increase(rag_query_duration_seconds_count{stage=\"generate\"}[10m])), 1)", "legendFormat": "no-answer"}]},
    {"id": 8, "type": "timeseries", "title": "Offline quality score and configured threshold", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}, "targets": [{"expr": "rag_evaluation_score", "legendFormat": "score {{quality_metric}} / {{dataset_split}} / {{retrieval_strategy}}"}, {"expr": "rag_evaluation_threshold", "legendFormat": "threshold {{quality_metric}} / {{dataset_split}}"}]},
    {"id": 9, "type": "timeseries", "title": "Document ingestion attempts", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}, "targets": [{"expr": "sum(rate(rag_ingestions_total[5m])) by (outcome)", "legendFormat": "{{outcome}}"}]},
    {"id": 10, "type": "timeseries", "title": "Chunks indexed per successful upload", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(rag_ingested_chunks_bucket[15m])) by (le))", "legendFormat": "p95 chunks/upload"}]},
    {"id": 11, "type": "timeseries", "title": "Tokens used (total)", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40}, "targets": [{"expr": "sum(llm_tokens_total) by (token_type, model)", "legendFormat": "{{token_type}} / {{model}}"}]}
  ],
  "links": [],
  "templating": {"list": []},
  "version": 2
}
