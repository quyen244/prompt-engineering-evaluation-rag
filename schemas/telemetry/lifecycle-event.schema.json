{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/telemetry/lifecycle-event.schema.json",
  "title": "RAG retrieval, generation, evaluation, and error telemetry events",
  "oneOf": [
    {"$ref": "#/$defs/retrieval"},
    {"$ref": "#/$defs/generation"},
    {"$ref": "#/$defs/evaluation"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": ["event_type", "event_version", "occurred_at", "request_id", "run_id", "retrieval_strategy", "prompt_version", "model_version", "dataset_split", "outcome"],
      "properties": {
        "event_version": {"const": "1.0"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "trace_id": {"type": ["string", "null"], "maxLength": 128},
        "retrieval_strategy": {"enum": ["bm25_only", "bm25_reranker", "dense", "hybrid"]},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "dataset_split": {"enum": ["train", "validation", "test", "production", "unknown"]},
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "outcome": {"enum": ["success", "no_answer", "error", "timeout", "cancelled"]}
      }
    },
    "retrieval": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieved_document_count"],
      "properties": {
        "event_type": {"const": "retrieval"},
        "event_version": {"const": "1.0"}, "occurred_at": {"type": "string", "format": "date-time"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128}, "run_id": {"type": "string", "minLength": 1, "maxLength": 128}, "trace_id": {"type": ["string", "null"], "maxLength": 128},
        "retrieval_strategy": {"enum": ["bm25_only", "bm25_reranker", "dense", "hybrid"]}, "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128}, "model_version": {"type": "string", "minLength": 1, "maxLength": 128}, "dataset_split": {"enum": ["train", "validation", "test", "production", "unknown"]}, "latency_ms": {"type": ["number", "null"], "minimum": 0}, "outcome": {"enum": ["success", "no_answer", "error", "timeout", "cancelled"]},
        "retrieved_document_count": {"type": "integer", "minimum": 0}, "top_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "context_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "generation": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_type": {"const": "generation"},
        "event_version": {"const": "1.0"}, "occurred_at": {"type": "string", "format": "date-time"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128}, "run_id": {"type": "string", "minLength": 1, "maxLength": 128}, "trace_id": {"type": ["string", "null"], "maxLength": 128},
        "retrieval_strategy": {"enum": ["bm25_only", "bm25_reranker", "dense", "hybrid"]}, "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128}, "model_version": {"type": "string", "minLength": 1, "maxLength": 128}, "dataset_split": {"enum": ["train", "validation", "test", "production", "unknown"]}, "latency_ms": {"type": ["number", "null"], "minimum": 0}, "outcome": {"enum": ["success", "no_answer", "error", "timeout", "cancelled"]},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0}, "completion_tokens": {"type": ["integer", "null"], "minimum": 0}, "cost_usd": {"type": ["number", "null"], "minimum": 0}, "finish_reason": {"enum": ["stop", "length", "content_filter", "tool_call", "unknown"]}
      }
    },
    "evaluation": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "type": "object",
      "additionalProperties": false,
      "required": ["quality_metric"],
      "properties": {
        "event_type": {"const": "evaluation"},
        "event_version": {"const": "1.0"}, "occurred_at": {"type": "string", "format": "date-time"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128}, "run_id": {"type": "string", "minLength": 1, "maxLength": 128}, "trace_id": {"type": ["string", "null"], "maxLength": 128},
        "retrieval_strategy": {"enum": ["bm25_only", "bm25_reranker", "dense", "hybrid"]}, "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128}, "model_version": {"type": "string", "minLength": 1, "maxLength": 128}, "dataset_split": {"enum": ["train", "validation", "test", "production", "unknown"]}, "latency_ms": {"type": ["number", "null"], "minimum": 0}, "outcome": {"enum": ["success", "no_answer", "error", "timeout", "cancelled"]},
        "quality_metric": {"enum": ["faithfulness", "correctness", "answer_relevancy", "hit_rate", "mrr", "precision", "recall", "ndcg"]}, "quality_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "quality_threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "error": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "error_type"],
      "properties": {
        "event_type": {"const": "error"},
        "event_version": {"const": "1.0"}, "occurred_at": {"type": "string", "format": "date-time"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128}, "run_id": {"type": "string", "minLength": 1, "maxLength": 128}, "trace_id": {"type": ["string", "null"], "maxLength": 128},
        "retrieval_strategy": {"enum": ["bm25_only", "bm25_reranker", "dense", "hybrid"]}, "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128}, "model_version": {"type": "string", "minLength": 1, "maxLength": 128}, "dataset_split": {"enum": ["train", "validation", "test", "production", "unknown"]}, "latency_ms": {"type": ["number", "null"], "minimum": 0}, "outcome": {"const": "error"},
        "stage": {"enum": ["upload", "parse", "chunk", "embed", "index", "retrieve", "rerank", "generate", "query", "ingest"]}, "error_type": {"enum": ["timeout", "upstream", "validation", "retrieval", "generation", "unknown"]}, "error_code": {"type": ["string", "null"], "maxLength": 128}, "retryable": {"type": "boolean"}
      }
    }
  }
}
