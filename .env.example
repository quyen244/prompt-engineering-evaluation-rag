# Copy file này thành .env rồi điền giá trị thật.
#   cp .env.example .env
#
# .env đã nằm trong .gitignore — KHÔNG BAO GIỜ commit nó.

# ---- OpenRouter (bắt buộc) ----
# Lấy tại https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ---- Model ----
# Model sinh câu trả lời
GEN_MODEL=inclusionai/ling-3.0-flash
# Model chấm điểm. PHẢI khác GEN_MODEL để tránh self-preference bias (Phase 1).
JUDGE_MODEL=google/gemini-2.5-flash

# ---- Embedding (chạy local, không cần API key) ----
# Chọn một trong: bge-small | bge-base | minilm | e5-multilingual
EMBEDDING_MODEL=bge-small

# ---- MLflow (Phase 1+) ----
# Local file-based khi practice:
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Khi chạy docker compose, đổi thành:
# MLFLOW_TRACKING_URI=http://localhost:5000

# ---- Qdrant (Phase 0/7) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_documents

# ---- Redis / Celery (Phase 6) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- OpenTelemetry (Phase 5) ----
OTEL_SERVICE_NAME=rag-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp

# ---- Debug ----
# Đặt =1 để bỏ qua disk cache của judge (tốn tiền, chỉ dùng khi cần)
NO_CACHE=0
